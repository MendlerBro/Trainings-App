# Kopiere diese Datei zu ".env" und trage deine echten Firebase-/Google-Werte ein.
# ".env" wird nicht ins Repo committet (siehe .gitignore).
#
# Woher bekomme ich die Werte? Siehe README.md, Abschnitt "Firebase & Login einrichten".

# Firebase-Projekt (Project Settings → Deine Web-App → SDK-Konfiguration)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In:
# 1) "Web-Client-ID" aus der Google Cloud Console (OAuth 2.0 Client-IDs, Typ "Web")
#    — wird von @react-native-google-signin/google-signin als `webClientId` gebraucht,
#    damit ein ID-Token erzeugt wird, das Firebase akzeptiert.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# 2) "iOS-Client-ID" (OAuth-Client vom Typ "iOS") — die REVERSED_CLIENT_ID davon
#    (Format: com.googleusercontent.apps.XXXXXXXXX) wird als URL-Scheme für den
#    nativen Google-Login auf iOS gebraucht. Steht in app.config.ts.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
