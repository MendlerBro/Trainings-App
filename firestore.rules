rules_version = '2';

// Jede Nutzerin/jeder Nutzer darf ausschließlich ihr/sein eigenes Dokument lesen
// und schreiben — erkannt an der Firebase-Auth-UID, die als Dokument-ID verwendet
// wird (siehe src/lib/cloudSync.ts). Kein Zugriff ohne gültige Anmeldung, keinerlei
// Zugriff auf die Daten anderer Nutzer.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
